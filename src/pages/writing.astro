---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import StarButton from '../components/StarButton.astro';
import { readingTime } from '../lib/readingTime';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<Layout title="Writing — Max P." description="Notes on Go, distributed systems, reliability, and applied AI.">
  <main class="container" id="main-content">
    <div class="writing-section">
      <h1>Writing</h1>
      <p class="intro">A technical notebook — Go, distributed systems, reliability, and whatever
      broke in production most recently.</p>
      {sortedArticles.length > 0 ? (
        <ul class="articles-list">
          {sortedArticles.map(article => (
            <li>
              <time datetime={article.data.publishDate.toISOString()}>
                {article.data.publishDate.toISOString().split('T')[0]}
              </time>
              <div class="article-info">
                <a href={`/writing/${article.data.slug}`}>
                  {article.data.title}
                  {article.data.description && (
                    <span class="description">{article.data.description}</span>
                  )}
                  <span class="meta-row">
                    {article.data.topic && <span class="topic">{article.data.topic}</span>}
                    <span class="reading-time">{readingTime(article.body ?? '')}</span>
                  </span>
                </a>
                <StarButton
                  articleSlug={article.data.slug}
                  featured={article.data.featured}
                />
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="no-articles">No articles published yet. Check back soon!</p>
      )}
    </div>
  </main>
</Layout>

<style>
  .writing-section {
    padding: 2rem 0;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--text-color);
  }

  .intro {
    color: var(--muted-color);
    margin: 0 0 2rem;
    max-width: 55ch;
    line-height: 1.6;
  }

  .articles-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .articles-list li {
    display: flex;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .articles-list li:first-child {
    border-top: 1px solid var(--border-color);
  }

  time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: var(--muted-color);
    min-width: 110px;
    margin-right: 1.5rem;
  }

  .articles-list a {
    color: var(--text-color);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .articles-list a:hover {
    color: var(--accent-color);
  }

  .description {
    font-size: 0.9rem;
    color: var(--muted-color);
    font-weight: normal;
  }

  .meta-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-weight: normal;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--muted-color);
  }

  .topic {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .no-articles {
    color: var(--muted-color);
    font-size: 1.1rem;
  }

  .article-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex: 1;
  }

  @media (max-width: 600px) {
    .writing-section {
      padding: 1rem 0;
    }

    h1 {
      font-size: 2rem;
      margin-bottom: 1.5rem;
    }

    .articles-list li {
      flex-direction: column;
      gap: 0.25rem;
    }

    time {
      min-width: unset;
      margin-right: 0;
    }
  }
</style>
