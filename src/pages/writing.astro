---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RevisedBadge from '../components/RevisedBadge.astro';
import { readingTime } from '../lib/readingTime';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const originalEntries = await getCollection('articlesOriginal');
const originalSlugs = new Set(originalEntries.map(o => o.data.slug));
---

<Layout title="Writing">
  <main class="container" id="main-content">
    <div class="articles-section">
      <h1>Writing</h1>
      {sortedArticles.length > 0 ? (
        <ul class="articles-list">
          {sortedArticles.map(article => (
            <li>
              <time datetime={article.data.publishDate.toISOString()}>
                {article.data.publishDate.getFullYear()}
              </time>
              <div class="title-block">
                <span class="title-with-badge">
                  <a href={`/writing/${article.data.slug}`}>{article.data.title}</a>
                  <RevisedBadge slug={article.data.slug} hasOriginal={originalSlugs.has(article.data.slug)} />
                </span>
                {article.data.description && (
                  <span class="description">{article.data.description}</span>
                )}
              </div>
              <span class="reading-time">{readingTime(article.body ?? '')}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="no-articles">No articles published yet. Check back soon!</p>
      )}
    </div>
  </main>
</Layout>

<style>
  .articles-section {
    padding: 2rem 0;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    font-weight: 500;
    color: var(--text-color);
  }

  .articles-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .articles-list li {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
  }

  time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--muted-color);
  }

  .title-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .title-with-badge {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .reading-time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--muted-color);
    white-space: nowrap;
  }

  .articles-list a {
    color: var(--text-color);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .articles-list a:hover {
    color: var(--accent-color);
  }

  .description {
    font-size: 0.9rem;
    color: var(--muted-color);
    font-weight: normal;
  }

  .no-articles {
    color: var(--muted-color);
    font-size: 1.1rem;
  }

  @media (max-width: 600px) {
    .articles-section {
      padding: 1rem 0;
    }

    h1 {
      font-size: 2rem;
      margin-bottom: 1.5rem;
    }

    .articles-list li {
      grid-template-columns: 2.25rem 1fr auto;
      gap: 0.5rem;
    }

    .reading-time {
      display: none;
    }
  }
</style>   