---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'about');
if (!entry) {
	return Astro.redirect('/404');
}
const { Content } = await render(entry);
---

<Layout title="About — Max P." description="Backend engineer working across distributed systems, integrations, and data infrastructure. Based in Chișinău, Moldova.">
	<main class="container" id="main-content">
		<article class="about-content">
			<h1>{entry.data.title}</h1>
			<Content />
		</article>
	</main>
</Layout>

<style>
	.about-content {
		padding: 2rem 0;
		max-width: 100%;
	}

	h1 {
		font-size: 2.5rem;
		margin-bottom: 2rem;
		font-weight: 500;
		color: var(--text-color);
	}

	:global(.about-content p) {
		margin: 1rem 0;
		line-height: 1.6;
		color: var(--text-color);
	}

  :global(.about-content code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9em;
    padding: 0.2em 0.4em;
    border-radius: 4px;
    background-color: rgba(128, 128, 128, 0.1);
  }

  :global(.about-content pre) {
    padding: 1rem;
    border-radius: 8px;
    background-color: rgba(128, 128, 128, 0.1);
    overflow-x: auto;
  }

  :global(.about-content pre code) {
    padding: 0;
    background-color: transparent;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 2rem;
      margin-bottom: 1.5rem;
    }
  }
</style>
