---
import Layout from '../layouts/Layout.astro';
---

<Layout title="@grumpycatyo-collab" description="Software engineer building reliable distributed systems, integrations, and data infrastructure. Go, Python, and a lot of production incidents.">
	<main class="container" id="main-content">
		<section class="hero">
			<p class="greeting"><em>Hello!</em> 👋</p>
			<h1>Software engineer building reliable distributed systems, integrations, and data infrastructure.</h1>
			<p class="description">
				I'm Max — I work mostly in <code>Go</code> and <code>Python</code>, on backend,
				reliability, and infrastructure problems. Most of what I build professionally is
				private, so this site holds selected case studies, writing, and whatever else I've
				been building.
			</p>
			<p class="hero-actions">
				<a href="/work">View selected work →</a>
				<a href="/writing">Read writing →</a>
				<a href="https://github.com/grumpycatyo-collab" target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href="https://www.linkedin.com/in/max-plamadeala/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
			</p>
		</section>
	</main>
</Layout>

<style>
  .hero {
    padding: 3rem 0 2.5rem;
  }

  .greeting {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.25;
    font-weight: 500;
    margin: 0 0 1rem;
    max-width: 22ch;
  }

  .description {
    max-width: 60ch;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted-color);
    margin: 0 0 1.5rem;
  }

  .description code {
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background-color: var(--bg-secondary);
    color: var(--text-color);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
  }

  .hero-actions a {
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .hero-actions a:hover {
    color: var(--accent-color);
  }

  @media (max-width: 600px) {
    .hero {
      padding: 2rem 0 1.5rem;
    }
  }
</style>
