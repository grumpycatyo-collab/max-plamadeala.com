---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../lib/readingTime';

const allArticles = await getCollection('articles');
const recommendedArticles = allArticles
  .filter(article => article.data.featured)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

let lastYear: number | null = null;
const recommendedRows = recommendedArticles.map(article => {
  const year = article.data.publishDate.getFullYear();
  const showYear = year !== lastYear;
  lastYear = year;
  return { article, year, showYear };
});
---

<Layout title="@grumpycatyo-collab" description="Software engineer building reliable distributed systems, integrations, and data infrastructure. Go, Python, and a lot of production incidents.">
	<main class="container" id="main-content">
		<section class="hero">
			<p class="greeting"><em>Hi there!</em> 👋</p>
			<h1> </h1>
			<p class="description">
				I'm Max — I work mostly in <code>Go</code> and <code>Python</code>, on backend,
				reliability, and infrastructure problems. Most of what I build professionally is
				private, so this site holds selected case studies, writing, and whatever else I've
				been building.
			</p>
			<p class="hero-actions">
				<a href="/work">View selected work →</a>
			</p>
		</section>

		{recommendedRows.length > 0 && (
			<section class="recommended">
				<h2 class="recommended-heading">Writing I'd recommend</h2>
				<ul class="recommended-list">
					{recommendedRows.map(({ article, year, showYear }) => (
						<li>
							<span class="rec-year">{showYear ? year : ''}</span>
							<a href={`/writing/${article.data.slug}`} class="rec-title">{article.data.title}</a>
							<span class="rec-time">{readingTime(article.body ?? '')}</span>
						</li>
					))}
				</ul>
			</section>
		)}
	</main>
</Layout>

<style>
  .hero {
    padding: 3rem 0 2.5rem;
  }

  .greeting {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.25;
    font-weight: 500;
    margin: 0 0 1rem;
    max-width: 22ch;
  }

  .description {
    max-width: 60ch;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted-color);
    margin: 0 0 1.5rem;
  }

  .description code {
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background-color: var(--bg-secondary);
    color: var(--text-color);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
  }

  .hero-actions a {
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .hero-actions a:hover {
    color: var(--accent-color);
  }

  .recommended {
    margin-top: 2.5rem;
  }

  .recommended-heading {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-color);
    margin: 0 0 1rem;
  }

  .recommended-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .recommended-list li {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
  }

  .rec-year {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--muted-color);
  }

  .rec-title {
    color: var(--text-color);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .rec-title:hover {
    color: var(--accent-color);
  }

  .rec-time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--muted-color);
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .hero {
      padding: 2rem 0 1.5rem;
    }

    .recommended-list li {
      grid-template-columns: 2.25rem 1fr auto;
      gap: 0.5rem;
    }
  }
</style>
